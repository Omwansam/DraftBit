# Base URL of the DraftBit API in ../backend (no trailing slash, no /api/v1 —
# the client adds the prefix itself).
#
# Leave blank to run the site entirely from src/data/site.js, with no backend.
# When set, published content, site settings and the contact form all go
# through the API, and page views are recorded for the admin dashboard.
VITE_API_URL=http://localhost:5000

# Optional fallback for the contact form when VITE_API_URL is not set.
# Sign up at https://formspree.io and paste your form endpoint URL.
VITE_FORMSPREE_ENDPOINT=
