# ---------------------------------------------------------------------------
# Port 443 — the two sites.
#
# Rendered only once a certificate exists on disk; see docker-entrypoint.sh for
# why. Both blocks share the same upstream pattern:
#
#   /api/     -> the API, directly. Going through the SPA container's own nginx
#               would work but adds a hop, and makes the proxy-hop count the
#               backend has to trust ambiguous.
#   /uploads/ -> the API, which serves them off its volume.
#   /         -> that site's static container.
#
# Upstreams are held in variables so nginx resolves them per request through
# Docker's embedded DNS. With a literal hostname nginx resolves at config load
# and refuses to start when a container is not up yet — meaning one crashed
# service would take down the whole edge, including the other site.
# ---------------------------------------------------------------------------

# www -> apex. A separate block rather than an `if` inside the main one: the
# certificate has to cover www either way, and this keeps the redirect out of
# the request path for everyone who arrived correctly.
server {
    listen               443 ssl;
    listen               [::]:443 ssl;
    http2                on;
    server_name          www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/nginx/snippets/ssl.conf;

    return 301 https://${DOMAIN}$request_uri;
}

# ------------------------------- Public site ------------------------------- #
server {
    listen               443 ssl;
    listen               [::]:443 ssl;
    http2                on;
    server_name          ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/nginx/snippets/ssl.conf;
    include             /etc/nginx/snippets/security.conf;

    # Uploaded images can be large; everything else here is small.
    client_max_body_size 12m;

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_api backend:5000;
        proxy_pass http://$upstream_api$request_uri;
    }

    location /uploads/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_uploads backend:5000;
        proxy_pass http://$upstream_uploads$request_uri;
        expires 30d;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_site company:80;
        proxy_pass http://$upstream_site$request_uri;
    }
}

# ------------------------------ Admin console ------------------------------ #
#
# Same API and uploads routing as the public site, because the console reads and
# writes the same records. It is a separate origin purely so a session cookie
# scoped to the portal is never sent by the public site.
server {
    listen               443 ssl;
    listen               [::]:443 ssl;
    http2                on;
    server_name          ${PORTAL_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/nginx/snippets/ssl.conf;
    include             /etc/nginx/snippets/security.conf;

    # The console is staff-only, so keep it out of search results entirely.
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 12m;

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_api backend:5000;
        proxy_pass http://$upstream_api$request_uri;
    }

    location /uploads/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_uploads backend:5000;
        proxy_pass http://$upstream_uploads$request_uri;
        expires 30d;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_admin admin:80;
        proxy_pass http://$upstream_admin$request_uri;
    }
}
