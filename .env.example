# Copy to .env and fill in the required values. `docker compose` reads this file
# automatically from the directory it is run in.

# ------------------------------------------------------------------ domain ---
# REQUIRED. The apex domain, with no scheme and no trailing slash.
# The edge proxy routes:
#   DOMAIN            -> the public marketing site
#   www.DOMAIN        -> 301 to DOMAIN
#   PORTAL_DOMAIN     -> the staff console
DOMAIN=draftbitlabs.tech
PORTAL_DOMAIN=portal.draftbitlabs.tech

# Where Let's Encrypt sends expiry warnings. Required for a real certificate.
LETSENCRYPT_EMAIL=

# Set to 1 to hit Let's Encrypt's staging CA. Staging certificates are NOT
# trusted by browsers, but the rate limits are generous — use it while you are
# still getting DNS and ports right, then unset it and re-run with --force.
LETSENCRYPT_STAGING=0

# ---------------------------------------------------------------- database ---
POSTGRES_USER=draftbit
# REQUIRED. Percent-encode any of @ : / ? in the password, since it is
# interpolated into DATABASE_URL as a URL.
POSTGRES_PASSWORD=
POSTGRES_DB=draftbitlabs
# Only used if you uncomment the `ports` block on the db service, which is
# commented out by default — an exposed Postgres on a public IP is found by
# scanners within hours. The API dials db:5432 inside the compose network and
# does not need this. Prefer an SSH tunnel for psql or Prisma Studio.
DB_PORT=5434

# ----------------------------------------------------------------- backend ---
# REQUIRED. Generate one with:  openssl rand -hex 48
# Changing it signs everyone out, which is the intended way to revoke every
# access token at once.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Proxy hops that append to X-Forwarded-For, counting outward from the API.
#   1  the edge nginx in this compose file
#   2  Cloudflare (or any other CDN) in front of it
# Getting this wrong breaks the rate limiters in one direction or the other:
# too low and every request looks like it came from nginx, too high and a
# client can forge X-Forwarded-For and appear to be any address it likes.
TRUST_PROXY=1

# These default to https://${DOMAIN} and https://${PORTAL_DOMAIN}. Override only
# if the API is reached at some other origin.
# FRONTEND_URL=
# ADMIN_URL=
# SITE_URL=

# --------------------------------------------------------------- frontends ---
# Baked into the bundle at BUILD time — change one and rebuild that image
# (`docker compose up -d --build company`); a restart will not pick it up.
#
# Both are relative on purpose, so the browser calls the same origin it is
# already on and the request never leaves the site it came from. An absolute
# URL here would reintroduce CORS and cross-site cookie problems.
SITE_API_URL=/api/v1
ADMIN_API_URL=/api/v1

# Optional fallback for the contact form when the API is unreachable.
VITE_FORMSPREE_ENDPOINT=

# ---------------------------------------------------------------- seed only ---
# Used by `docker compose exec backend npm run seed`. Change the password
# immediately after the first sign-in.
SEED_OWNER_EMAIL=owner@draftbitlabs.tech
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=DraftBit Owner
