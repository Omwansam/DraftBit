# Copy to .env and fill in the two required values. `docker compose` reads this
# file automatically from the directory it is run in.

# ---------------------------------------------------------------- database ---
POSTGRES_USER=draftbit
# REQUIRED. Percent-encode any of @ : / ? in the password, since it is
# interpolated into DATABASE_URL as a URL.
POSTGRES_PASSWORD=
POSTGRES_DB=draftbitlabs
# Host port for psql/Prisma Studio access. The API always talks to db:5432
# inside the compose network regardless of this. Avoid 5432/5433 — a system
# Postgres and the local dev instance already use those.
DB_PORT=5434

# ----------------------------------------------------------------- backend ---
# REQUIRED. Generate one with:  openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
BACKEND_PORT=5000
# Must be the public site's origin. The API refuses to boot in production
# without it, because CORS cannot be locked down otherwise.
FRONTEND_URL=http://localhost:8080

# --------------------------------------------------------------- frontends ---
SITE_PORT=8080
ADMIN_PORT=8081
SITE_URL=http://localhost:8080

# Baked into the bundle at BUILD time — change one and rebuild that image
# (`docker compose up -d --build company`), a restart will not pick it up.
#
# Public site: relative path so requests go through its own nginx proxy.
SITE_API_URL=/api/v1
# Admin console: empty keeps it in demo mode (seeded localStorage data, no API
# needed). Set to /api/v1 once the backend's auth routes actually work.
ADMIN_API_URL=
# Optional contact-form endpoint for the public site.
VITE_FORMSPREE_ENDPOINT=
