# Base URL of the Flask API in ../BACKEND (no trailing slash).
# Leave this blank to run the console in demo mode: all data is seeded from the
# public site's content and persisted to localStorage, so every screen is fully
# usable without a running backend.
VITE_API_URL=

# Public site URL, used by "View on site" links throughout the console.
VITE_SITE_URL=http://localhost:5173
