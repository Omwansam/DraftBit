# Base URL of the DraftBit API in ../backend (no trailing slash, no /api/v1 —
# the client adds the version prefix itself).
#
# Leave blank to run the console in demo mode: all data is seeded from the
# public site's content and persisted to localStorage, so every screen is fully
# usable without a running backend.
VITE_API_URL=http://localhost:5000

# Public site URL, used by "View on site" links throughout the console.
VITE_SITE_URL=http://localhost:5173
