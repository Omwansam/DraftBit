# Compose reads .env from this directory — on a VPS it holds POSTGRES_PASSWORD
# and JWT_SECRET, so it must never be committed. The template is .env.example.
.env
.env.*
!.env.example

node_modules/
dist/

npm-debug.log*
yarn-error.log*
.DS_Store

# Vite's local dependency cache. Regenerated on every dev-server start and
# machine-specific, so committing it only produces conflicts — a stale
# _metadata.json can also make Vite serve pre-bundled deps that no longer match
# package.json.
.vite/
*/.vite/
