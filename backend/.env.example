# Copy to .env and fill in. .env is gitignored; this file is not.

# ---------------------------------------------------------------------------
# Database — any PostgreSQL 14+ instance.
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Managed providers (Neon, Supabase, Railway) usually also want ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Proxy hops in front of Express. Set to 1 behind the nginx edge proxy, so
# req.ip is the real client rather than the proxy — the rate limiters key on it.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Auth
# JWT_SECRET must be long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every access token at once.
# ---------------------------------------------------------------------------
JWT_SECRET=
# Access tokens are short-lived; the refresh cookie carries the long session.
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# CORS
# Required in production, where it is the ONLY accepted browser origin (plus its
# www form). Left empty in development, the API reflects the caller's origin,
# which is what makes the Vite dev servers on 5173/5174 work.
# ---------------------------------------------------------------------------
FRONTEND_URL=

# Used to build invite links and "view on site" URLs.
ADMIN_URL=http://localhost:5174
SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Seed only (npm run seed). Creates the first Owner so there is a way in.
# Change the password after the first sign-in.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@draftbit.com
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=DraftBit Owner
